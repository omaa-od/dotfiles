// DMS Window Rules - Managed by Dux Modular Shell
// Do not edit manually - changes may be overwritten

// @id=wr_1793555413540866892 @name=md.obsidian.Obsidian
window-rule {
    match app-id="^md.obsidian.Obsidian$"
    opacity 0.99
    open-floating false
    default-column-width { proportion 0.9; }
    background-effect {
        blur true
        xray true
        noise 0.05
        saturation 1.3
    }
}

// @id=wr_1793976802031618341 @name=org.gnome.Nautilus
window-rule {
    match app-id="^org.gnome.Nautilus$"
    opacity 0.89
    background-effect {
        blur true
        saturation 1.61
    }
}

// @id=wr_1793976828866465440 @name=Alacritty
window-rule {
    match app-id="^Alacritty$"
    background-effect {
        blur true
        xray true
    }
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
